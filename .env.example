# Host Ports
CKAN_PORT_HOST=5000
NGINX_SSLPORT_HOST=5000

# CKAN databases
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
CKAN_DB_USER=ckandbuser
CKAN_DB_PASSWORD=ckandbpassword
CKAN_DB=ckandb
DATASTORE_READONLY_USER=datastore_ro
DATASTORE_READONLY_PASSWORD=datastore
DATASTORE_DB=datastore
CKAN_SQLALCHEMY_URL=postgresql://ckandbuser:ckandbpassword@db/ckandb
CKAN_DATASTORE_WRITE_URL=postgresql://ckandbuser:ckandbpassword@db/datastore
CKAN_DATASTORE_READ_URL=postgresql://datastore_ro:datastore@db/datastore

# Test database connections
TEST_CKAN_SQLALCHEMY_URL=postgres://ckan:ckan@db/ckan_test
TEST_CKAN_DATASTORE_WRITE_URL=postgresql://ckan:ckan@db/datastore_test
TEST_CKAN_DATASTORE_READ_URL=postgresql://datastore_ro:datastore@db/datastore_test

# Dev settings
USE_HTTPS_FOR_DEV=false

# CKAN core
CKAN_VERSION=2.11.7
CKAN_SITE_ID=default
CKAN_SITE_URL=https://localhost:5000
CKAN___BEAKER__SESSION__SECRET=CHANGE_ME
# See https://docs.ckan.org/en/latest/maintaining/configuration.html#api-token-settings
CKAN___API_TOKEN__JWT__ENCODE__SECRET=string:CHANGE_ME
CKAN___API_TOKEN__JWT__DECODE__SECRET=string:CHANGE_ME
CKAN_SYSADMIN_NAME=ckan_admin
CKAN_SYSADMIN_PASSWORD=test1234
CKAN_SYSADMIN_EMAIL=your_email@example.com
CKAN_STORAGE_PATH=/var/lib/ckan
CKAN_SMTP_SERVER=smtp.corporateict.domain:25
CKAN_SMTP_STARTTLS=True
CKAN_SMTP_USER=user
CKAN_SMTP_PASSWORD=pass
CKAN_SMTP_MAIL_FROM=ckan@localhost
CKAN_MAX_UPLOAD_SIZE_MB=100
TZ=UTC

# Solr
SOLR_IMAGE_VERSION=2.11-solr9
CKAN_SOLR_URL=http://solr:8983/solr/ckan
TEST_CKAN_SOLR_URL=http://solr:8983/solr/ckan

# Redis
REDIS_VERSION=7
CKAN_REDIS_URL=redis://redis:6379/1
TEST_CKAN_REDIS_URL=redis://redis:6379/1

# XLoader
CKANEXT__XLOADER__JOBS_DB__URI=${CKAN_SQLALCHEMY_URL}
# Address the jobs worker uses to download resources from CKAN itself
CKANEXT__XLOADER__SITE_URL=http://localhost:5000
# Keep column names as they are in the file (default transliterates them to Latin)
CKANEXT__XLOADER__UNIDECODE_HEADERS=false
# Unset: a sysadmin token is created on startup (docker-entrypoint.d/01_setup_xloader.sh).
# Set it to keep one fixed token instead.
#CKANEXT__XLOADER__API_TOKEN=

# NGINX
NGINX_SSLPORT=443

# Extensions
# geojson_view previews GeoJSON resources on a map; resource_proxy lets it show
# GeoJSON files hosted on other domains.
CKAN__PLUGINS="sofia image_view text_view webpage_view datatables_view datastore xloader resource_proxy geo_view geojson_view activity tracking stats scheming_datasets scheming_organizations pages showcase dcat structured_data pdf_view envvars"

CKAN__VIEWS__DEFAULT_VIEWS="image_view geojson_view datatables_view pdf_view"

# Basemap for the map views - without it they show "No map provider set"
CKANEXT__SPATIAL__COMMON_MAP__TYPE=custom
CKANEXT__SPATIAL__COMMON_MAP__CUSTOM_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
CKANEXT__SPATIAL__COMMON_MAP__ATTRIBUTION="&copy; OpenStreetMap contributors"
# Remote GeoJSON is fetched through resource_proxy, which defaults to a 1MB limit
CKAN__RESOURCE_PROXY__MAX_FILE_SIZE=314572800
# GeoJSON files bigger than this (100 MB) are rendered only on request, not on page load,
# to avoid freezing the browser.
CKANEXT__GEOVIEW__GEOJSON__MAX_FILE_SIZE=104857600

CKAN__HARVEST__MQ__TYPE=redis
CKAN__HARVEST__MQ__HOSTNAME=redis
CKAN__HARVEST__MQ__PORT=6379
CKAN__HARVEST__MQ__REDIS_DB=1

CKAN___DEBUG=FALSE

# Local development (docker-compose.local.yml: ckanext-sofia from ./src, CKAN
# port on the network). Leave unset in production.
#COMPOSE_PATH_SEPARATOR=:
#COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
# Activity streams: dashboard of followed datasets, groups and organisations
# ("Любими") and email digests of their changes. Users opt in from their profile.
CKAN__ACTIVITY_STREAMS_EMAIL_NOTIFICATIONS=true
CKAN__EMAIL_NOTIFICATIONS_SINCE="1 day"
# How often the digests are sent, in seconds (docker-entrypoint.d/05_send_email_notifications.sh)
CKAN_EMAIL_NOTIFICATIONS_INTERVAL=3600
# Usage tracking: page views and downloads, "popular" sorting (views_recent).
# The counts are summarised and indexed by docker-entrypoint.d/06_update_tracking.sh.
CKAN_TRACKING_UPDATE_INTERVAL=86400
# Dataset collaborators (TS 2.1-B): people outside the organisation get access to
# one dataset, including restricted ("При заявка"/"Платени") data.
CKAN__AUTH__ALLOW_DATASET_COLLABORATORS=true
CKAN__AUTH__ALLOW_ADMIN_COLLABORATORS=false
CKAN__AUTH__ALLOW_COLLABORATORS_TO_CHANGE_OWNER_ORG=false
# uWSGI web workers (TS §I: 600 datasets, 1 000-1 500 users). The image starts 2
# processes; these options are appended and override that.
EXTRA_UWSGI_OPTS="--processes 4 --threads 2"
# Scheming (TS 2.1-A access level, 2.1-B how to request data, 2.2-B organisation type)
CKAN___SCHEMING__DATASET_SCHEMAS=file:///srv/app/schemas/sofia_dataset.yaml
CKAN___SCHEMING__ORGANIZATION_SCHEMAS=file:///srv/app/schemas/sofia_organization.yaml
CKAN___SCHEMING__PRESETS=ckanext.scheming:presets.json
# Pages and blog (TS 2.2-A "Актуално" and news on the home page, 2.2-B planned publications)
# Only sysadmins edit pages, so HTML (embedded charts, iframes) is allowed.
CKANEXT__PAGES__ORGANIZATION=false
CKANEXT__PAGES__GROUP=false
CKANEXT__PAGES__ABOUT_MENU=false
CKANEXT__PAGES__ALLOW_HTML=true
CKANEXT__PAGES__EDITOR=ckeditor
# Showcases, shown as "Истории с данни" (TS 2.2-A)
CKANEXT__SHOWCASE__EDITOR=ckeditor
# DCAT (TS 2.2-B): /catalog.ttl, /catalog.xml, /dataset/<id>.rdf|.ttl|.jsonld and
# schema.org JSON-LD in the dataset pages (structured_data)
CKANEXT__DCAT__RDF__PROFILES=euro_dcat_ap_3
CKANEXT__DCAT__ENABLE_CONTENT_NEGOTIATION=false
# PDF previews for reports and analyses (TS 2.2-A); also in the default views
